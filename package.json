{
  "name": "prompower-academy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/sim-core",
    "packages/robot-plugins/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "convert-meshes": "tsx scripts/convert-meshes.ts",
    "postinstall": "tsx scripts/sync-draco.ts && tsx scripts/convert-meshes.ts --all",
    "sync-draco": "tsx scripts/sync-draco.ts"
  },
  "dependencies": {
    "@prompower/robot-jaka-6dof": "*",
    "@prompower/robot-placeholder-6dof": "*",
    "@prompower/sim-core": "*",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "next": "15.5.25",
    "next-intl": "4.14.2",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "three": "0.185.1",
    "urdf-loader": "0.13.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/draco3dgltf": "^1.4.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "draco3dgltf": "1.5.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
